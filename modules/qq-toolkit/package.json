{
  "name": "qq-toolkit",
  "version": "2.0.0-beta.1",
  "description": "QQ 专属工具：协议扩展接口、群管、资料修改、好友与加群申请",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "aurabot": {
    "displayName": "QQ 工具箱",
    "category": "social",
    "capabilities": [
      "network",
      "filesystem",
      "plugin-config"
    ],
    "minPluginVersion": "2.0.0-beta.1",
    "api": 2,
    "platforms": [
      "qq"
    ],
    "reloadOnConfig": true
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@aurabot/plugin-api": "file:../../vendor/aurabot-plugin-api-2.0.0-beta.22.tgz",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  }
}
