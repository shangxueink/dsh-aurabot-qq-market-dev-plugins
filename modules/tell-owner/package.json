  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "@aurabot/plugin-api": "file:../../vendor/aurabot-plugin-api-2.0.0-beta.17.tgz"
  }
