{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "outDir": "dist",
    "rootDir": "client",
    "declaration": false,
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true,
    "removeComments": true
  },
  "include": ["client/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
